GROQ_API_KEY=

# Research Agent — Tavily web search
TAVILY_API_KEY=

# Finance Agent — market data APIs (all optional; agent falls back to LLM knowledge)
FINNHUB_API_KEY=
TWELVE_DATA_API_KEY=
FMP_API_KEY=
MARKETAUX_API_KEY=
